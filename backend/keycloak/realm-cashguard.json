{
  "realm": "cashguard",
  "displayName": "CashGuard",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 86400,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername(undefined)",
  "roles": {
    "realm": [
      { "name": "internal", "description": "Cron jobs: may call /api/internal/*" },
      { "name": "sim", "description": "Demo operator: may drive the simulator /api/sim/* (SIM_MODE only)" }
    ]
  },
  "clients": [
    {
      "clientId": "savings-frontend",
      "name": "CashGuard app",
      "description": "Flutter app: authorization code + PKCE (S256)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["ro.cashguard.app:/oauthredirect", "http://localhost:*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "savings-cron",
      "name": "CashGuard cron",
      "description": "Cron container: client credentials, realm role internal",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_CRON_CLIENT_SECRET:dev-cron-secret}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "savings-dev",
      "name": "CashGuard dev scripts",
      "description": "DEV/TEST ONLY: password grant (ROPC) for the smoke scripts and tests. The hosted demo keeps it for scripts/smoke_remote.sh; disable it (enabled=false) on any real deployment. Brute-force protection and the required KC_DEMO_PASSWORD limit it meanwhile.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-savings-cron",
      "enabled": true,
      "serviceAccountClientId": "savings-cron",
      "realmRoles": ["default-roles-cashguard", "internal"]
    },
    {
      "id": "a0000000-0000-4000-8000-000000000001",
      "username": "matei",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Matei",
      "lastName": "Demo",
      "email": "matei@demo.cashguard.ro",
      "requiredActions": [],
      "realmRoles": ["default-roles-cashguard", "sim"],
      "credentials": [{ "type": "password", "value": "${KC_DEMO_PASSWORD:cashguard-dev}", "temporary": false }]
    },
    {
      "id": "a0000000-0000-4000-8000-000000000002",
