# Copy to .env and fill in. Never commit .env.

# Postgres (dev DB from docker compose; host port 5434 because 5432 is often taken locally)
DATABASE_URL=postgresql+psycopg://cashguard:cashguard@localhost:5434/cashguard
TEST_DATABASE_URL=postgresql+psycopg://cashguard:cashguard@localhost:5433/cashguard_test

# Claude (arch 6.8)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# Keycloak (arch 5.1). Hosted: both must be the public HTTPS URL (D36)
KEYCLOAK_ISSUER=http://localhost:8080/realms/cashguard
KEYCLOAK_AUDIENCE=cashguard-api

# Simulator & time
SIM_MODE=true
SIM_START_DATE=2026-06-15
TZ=Europe/Bucharest

# Agent
MAX_AGENT_ITERATIONS=6
QUESTIONS_PER_DAY=1

LOG_LEVEL=INFO
