# CashGuard backend settings, read by app/config.py (Settings). For local development:
#   cp .env.example .env
# Never commit .env (it's gitignored). An empty value means "not set": the code default applies.
# Real environment variables beat this file. Every variable the app reads is listed here, and
# tests/unit/test_config.py fails if this file and Settings drift apart.

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# The driver is psycopg 3, so URLs start with postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://cashguard:cashguard@localhost:5434/cashguard
# The throwaway test database: `make db-up` (compose service db-test, port 5435).
TEST_DATABASE_URL=postgresql+psycopg://cashguard:cashguard@localhost:5435/cashguard_test

# ── Claude (arch 6.8) ────────────────────────────────────────────────────────────────────────
# Needed only for real Claude calls (tests use a fake LLM). Never put a real key in this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max (low keeps voice replies fast)
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (beta, Claude API only). Off unless it's proven to help.
ANTHROPIC_REFUSAL_FALLBACK=false
# anthropic (ANTHROPIC_API_KEY) | bedrock (Amazon Bedrock with the AWS_* below; the hackathon's way).
# On Bedrock the model becomes the inference profile (us.anthropic.claude-sonnet-5-5) and the refusal fallback is off.
LLM_PROVIDER=anthropic
# Amazon Bedrock only (Oregon, us-west-2). Either a Bedrock API key (preferred: console ->
# Amazon Bedrock -> API keys) or the temporary AWS credentials below (they expire: paste fresh ones).
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Keycloak (arch 5.1) ──────────────────────────────────────────────────────────────────────
# Must equal the tokens' `iss` exactly. Hosted: Keycloak's public HTTPS URL (= KC_HOSTNAME).
KEYCLOAK_ISSUER=http://localhost:8081/realms/cashguard
KEYCLOAK_AUDIENCE=cashguard-api
# Where the API fetches discovery/JWKS when it differs from the issuer (docker sets it to http://keycloak:8080/...)
KEYCLOAK_INTERNAL_URL=
# Secret of the confidential client savings-cron (the cron container uses it).
KEYCLOAK_CRON_CLIENT_SECRET=

# ── Keycloak container (docker compose reads these, not the app) ─────────────────────────────
KC_HOSTNAME=http://localhost:8081
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_CRON_CLIENT_SECRET=dev-cron-secret
KC_DB_PASSWORD=keycloak
# Password of the 5 persona users (matei, andrei, bianca, ioana, alex). Set a real one when hosted.
KC_DEMO_PASSWORD=cashguard-dev

# ── Demo and agent ───────────────────────────────────────────────────────────────────────────
# true enables the /sim/* endpoints and the simulator clock (the demo runs with true).
SIM_MODE=true
SIM_START_DATE=2026-06-15
# SIM_MODE only: read the simulator's date from the sim_clock table at startup.
SIM_CLOCK_FROM_DB=true
MAX_AGENT_ITERATIONS=6
# Claude calls in flight at once (1-32); more wait their turn.
LLM_MAX_CONCURRENCY=4
QUESTIONS_PER_DAY=1
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Swagger UI (/api/docs) and /api/openapi.json. On for local dev; the hosted overlay sets false.
API_DOCS_ENABLED=true

# ── App API: David V.'s Flutter app (API_SPEC.md), root routes, no auth, one demo user ───────
# false in code; on here so `make dev` serves the app. Turn it off on a public host if unused.
APP_API_ENABLED=true
# The demo user: a users.keycloak_sub (default: Matei) or a numeric users.id.
APP_API_USER=a0000000-0000-4000-8000-000000000001
# POST /assistant/messages: the longest message (+ the `chat` rate limit below, one reply at a time).
APP_API_MAX_TEXT_CHARS=2000
# The stream sends an `error` event after this many seconds (the run itself continues).
APP_API_REPLY_TIMEOUT_S=120
APP_API_HISTORY_LIMIT=100
APP_API_MAX_DEVICES=5
# CORS for Flutter web / browser debugging (the native app needs none). ^$ = no origin allowed.
APP_API_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# Push: path to the Firebase service-account JSON (project cashctrl-6b66a). Never commit it.
# Empty = pushes are logged and skipped.
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=

# ── Rate limits (app/security/ratelimit.py): per principal, in memory (1 uvicorn worker) ─────
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=200
RATE_LIMIT_SIM_PER_MINUTE=5
RATE_LIMIT_WS_CONNECT_PER_MINUTE=10

# ── Not read by the app ──────────────────────────────────────────────────────────────────────
# TZ: the app's day boundaries are always Europe/Bucharest (app/clock.py, arch Q25), whatever the
# server's TZ. Set TZ=Europe/Bucharest on the cron container: its crontab times are local times.
TZ=Europe/Bucharest
# Hosted deployment only (deploy/docker-compose.prod.yml, docs/deploy.md)
# DOMAIN=cashguard.example.ro
# CRON_ENABLED_JOBS=process recover
