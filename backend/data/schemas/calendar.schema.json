{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CashGuard calendar events (backend/data/calendar.json)",
  "description": "Romanian calendar events for expected spending (C11): fixed dates, computed ones (Orthodox Easter, Meeus Julian algorithm: 2026 -> 12 April) and configurable dates (school start, Black Friday). lead_days = how many days before the date the spending starts; requires_child_age = only for a household with a child in this age range (inclusive). Load strictly, as tests/unit/datafiles.py parse_json does.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixed",
    "computed",
    "configurable"
  ],
  "properties": {
    "fixed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixed"
      }
    },
    "computed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/computed"
      }
    },
    "configurable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configurable"
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "id",
        "name",
        "categories",
        "lead_days"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "maxLength": 40
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ro",
            "en"
          ],
          "properties": {
            "ro": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "groceries",
              "restaurants",
              "food_delivery",
              "transport",
              "fuel",
              "electronics",
              "clothing",
              "sport",
              "health_pharmacy",
              "kids",
              "education",
              "books",
              "entertainment",
              "subscriptions",
              "travel",
              "housing_rent",
              "utilities",
              "telecom",
              "gifts",
              "pets",
              "household_goods",
              "personal_care",
              "transfers",
              "income",
              "savings",
              "other"
            ]
          }
        },
        "lead_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 45
        },
        "requires_child_age": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "fixed": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "month",
        "day"
      ],
      "properties": {
        "id": true,
        "name": true,
        "categories": true,
        "lead_days": true,
        "requires_child_age": true,
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "additionalProperties": false
    },
    "computed": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "rule"
      ],
      "properties": {
        "id": true,
        "name": true,
        "categories": true,
        "lead_days": true,
        "requires_child_age": true,
        "rule": {
          "enum": [
            "orthodox_easter"
          ]
        }
      },
      "additionalProperties": false
    },
    "configurable": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "dates"
      ],
      "properties": {
        "id": true,
        "name": true,
        "categories": true,
        "lead_days": true,
        "requires_child_age": true,
        "dates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
