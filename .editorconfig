# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.dart]
indent_size = 2
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.{kt,kts,gradle,swift}]
indent_size = 4
